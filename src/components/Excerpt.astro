---
// A verbatim quotation from the manuscript. Its inline maths is rendered with KaTeX at build time.
import { excerptHtml } from '../lib/manuscript';
interface Props { text: string; section?: { num: string | null; title: string; href: string | null } | null }
const { text, section } = Astro.props;
const html = excerptHtml(text);
---
<blockquote class="excerpt">
  <Fragment set:html={html} />
  {section && (section.href || section.num) && <footer>Survey {section.href ? <a href={section.href}>{`§${section.num} ${section.title}`}</a> : <>§{section.num}</>}</footer>}
</blockquote>
