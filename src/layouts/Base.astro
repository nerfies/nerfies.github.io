---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE, NAV, base, url } from '../lib/site';
import { draftHidden, isDraft } from '../lib/manuscript';
import publication from '../data/publication.json';

interface Props {
  title?: string; description?: string; image?: string; wide?: boolean;
  /** Not a content page (search, notices): excluded from search engines and the site's own search. */
  noindex?: boolean;
  /** Built from the manuscript text. Follows src/data/publication.json while the manuscript is a draft. */
  manuscript?: boolean;
}
const { title, description = 'An interactive handbook for the survey "The State of Mechanistic Interpretability for AI Safety": the survey text, a methods explorer, evaluation framework, research orientations, open problems and runnable notebooks.', image = 'static/images/survey_overview.png' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.short}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url(image), Astro.site);
const path = Astro.url.pathname;
const robotsNoindex = Astro.props.noindex || (Astro.props.manuscript && isDraft && !publication.indexDraftPages);
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {robotsNoindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href={url('static/images/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={url('static/images/favicon.png')} type="image/png" sizes="162x162" />
  <link rel="apple-touch-icon" href={url('static/images/favicon.png')} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f4f4f4" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href={base}>The State of Mechanistic Interpretability<br class="brand-br" /> <em>for AI Safety</em></a>
      <button class="icon-btn menu-btn" aria-expanded="false" aria-controls="site-nav" id="menu-btn">Menu</button>
      <nav class="site-nav" id="site-nav" aria-label="Main">
        {NAV.filter((n) => !(draftHidden && n.draft)).map((n) => <a href={url(n.href)} aria-current={path.startsWith(url(n.href)) ? 'page' : undefined}>{n.label}</a>)}
        <a href={url('search/')} aria-current={path.startsWith(url('search/')) ? 'page' : undefined}>Search</a>
      </nav>
      <button class="icon-btn" id="theme-btn" aria-label="Switch between light and dark">Dark</button>
    </div>
  </header>
  <main id="main" data-pagefind-body={Astro.props.noindex ? undefined : ''}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class="inner">
      <div>{SITE.title}. Correspondence: <a href={`mailto:${SITE.contact}`}>{SITE.contact}</a>.</div>
      <div>Notebooks: <a href={SITE.notebooksRepo}>TSGLAB/Interpretability_Survey_Safety</a> · Site source: <a href={SITE.siteRepo}>TSGLAB/mechinterp-safety</a></div>
      <div>The original project page was built using the <a href="https://github.com/eliahuhorwitz/Academic-project-page-template">Academic Project Page Template</a>, adopted from the <a href="https://nerfies.github.io">Nerfies</a> project page. Licensed under <a rel="license" href="http://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.</div>
    </div>
  </footer>
  <script is:inline>
    (function () {
      const root = document.documentElement;
      document.getElementById('theme-btn').addEventListener('click', () => {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        label();
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
      function label() {
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.getElementById('theme-btn').textContent = dark ? 'Light' : 'Dark';
      }
      label();
      const mb = document.getElementById('menu-btn'), nav = document.getElementById('site-nav');
      mb.addEventListener('click', () => { const o = nav.classList.toggle('open'); mb.setAttribute('aria-expanded', String(o)); });
    })();
  </script>
</body>
</html>
