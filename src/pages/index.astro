---
import Base from '../layouts/Base.astro';
import { SITE, url } from '../lib/site';
import { chapters, manifest } from '../lib/manuscript';
import notebooks from '../data/notebooks.json';

// Authors and affiliations are copied verbatim from the original project page.
const authors: [string, string, boolean?][] = [
  ['Fazl Barez', '1,2', true], ['Tung-Yu Wu', '1', true], ['Aaron Maiwald', '3'], ['Abir Harrasse', '2'], ['Adi Simhi', '4'],
  ['Antía García', '2'], ['Belinda Z. Li', '5'], ['Damiano Fornasiere', '6'], ['Florent Draye', '7'], ['Gabriele Dominici', '8'],
  ['Hunar Batra', '3'], ['Michael Lan', '2'], ['Narmeen Fatimah Oozeer', '2'], ['Or David Shafran', '9'], ['Riley Harris', '3'],
  ['Robert Trager', '3'], ['Sara Hooker', '10'], ['Shay B. Cohen', '11'], ['Shriyash Kaustubh Upadhyay', '2'], ['Yanai Elazar', '12'],
  ['Yu Zhao', '11'], ['Ziyu Yao', '13'], ['Naomi Saphra', '14', true], ['Mor Geva', '9', true], ['Yoshua Bengio', '6,15', true],
  ['Stella Biderman', '16', true], ['Hassan Sajjad', '17', true],
];
const affiliations = ['TSG Lab, University of Oxford', 'Martian', 'University of Oxford', 'Technion', 'Anthropic', 'LawZero',
  'Max Planck Institute for Intelligent Systems', 'Università della Svizzera italiana', 'Tel Aviv University', 'Adaption Labs',
  'University of Edinburgh', 'Bar-Ilan University', 'George Mason University', 'Boston University', 'Mila, Université de Montréal',
  'EleutherAI', 'Dalhousie University'];

const pillars = [
  { n: 1, title: 'Motivation & Concepts', summary: 'Fundamental knowledge and core hypotheses.', href: 'handbook/',
    cta: 'Read the foundations',
    items: [['Limits of Behavioural Evaluation', ''], ['Overview of Interpretability Methods', 'Behavioural, attribution, concept-based, probing'],
      ['Core Concepts', 'Polysemanticity, features, transformer computation, circuits'],
      ['Core Hypotheses', 'Linear representation, superposition, privileged access, universality & Platonic representation']] },
  { n: 2, title: 'Technical Methods', summary: 'Approaches developed and used in interpretability research.', href: 'methods/',
    cta: 'Explore the methods',
    items: [['Feature Extraction & Multi-Layer Analysis', 'SAEs, transcoders, CLTs, crosscoders, DAS, NMF, PCA, ICA'],
      ['Circuits', 'Activation patching, path patching, circuit discovery, unified evaluation framework'],
      ['Understanding Intermediate Representations', 'Logit lens, tuned lens, Jacobian lens, Patchscopes, LatentQA, probes'],
      ['Training Data Attribution', 'Verbatim TDA, gradient-based TDA'],
      ['Learning Dynamics', 'Phase transitions, SLT, emergent abilities, train-time interventions, machine unlearning'],
      ['Representation Analysis', 'Model diffing, knowledge localisation, representation engineering']] },
  { n: 3, title: 'Research Directions', summary: 'Six research orientations, characterised by their goals, assumptions, and trade-offs.', href: 'orientations/',
    cta: 'Compare the orientations',
    items: [['Pragmatic Interpretability', 'Proxy-task-oriented safety interventions'], ['Ambitious Interpretability', 'Towards complete mechanistic understanding'],
      ['Developmental Interpretability', 'Characterising how models learn'], ['Interpretability Across Time', 'Understanding the causes of model behaviours'],
      ['Introspective Interpretability', 'Models interpreting themselves'], ['Automated Interpretability', 'Scaling discovery via automation']] },
  { n: 4, title: 'Safety & Open Problems', summary: 'Deployment-oriented interventions and the critical challenges that remain.', href: 'safety/',
    cta: 'Browse applications and open problems',
    items: [['Safety Applications', 'Concept erasure & knowledge editing, steering vectors & mechanistic monitoring, interpretability agents, risks & failure modes'],
      ['Open Problems', 'When is mechanistic understanding necessary? Evaluation methods, scalability & adversarial robustness, alignment, interpretation vs. truth, proxy fidelity, transferability beyond transformers']] },
];
const jsonld = {
  '@context': 'https://schema.org', '@type': 'ScholarlyArticle',
  headline: `${SITE.title}: ${SITE.subtitle}`,
  description: 'A survey of interpretability for AI safety, focusing on mechanistic interpretability: foundations, methods, six research orientations, safety applications, and open problems.',
  author: authors.map(([name]) => ({ '@type': 'Person', name })),
  image: new URL(url('static/images/survey_overview.png'), Astro.site).toString(),
  keywords: ['mechanistic interpretability', 'interpretability', 'AI safety', 'survey'], isAccessibleForFree: true,
};
---
<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  <section class="hero">
    <div class="hero-inner">
      <p class="eyebrow">Survey · Interactive handbook</p>
      <h1 class="hero-title">The State of Interpretability for AI Safety<span>A Survey of Foundations, Methods, and Research Directions</span></h1>
      <p class="hero-q">Does understanding how models work actually make them safer?</p>
      <div class="authors">
        {authors.map(([n, a, core], i) => <><span class="author">{n}<sup>{a}{core ? ', †' : ''}{i === 0 ? ' *' : ''}</sup>{i < authors.length - 1 ? ',' : ''}</span>{' '}</>)}
      </div>
      <details class="affils">
        <summary>Affiliations</summary>
        <ol>{affiliations.map((a) => <li>{a}</li>)}</ol>
      </details>
      <p class="small muted">† Core contributors · * Correspondence: <a href={`mailto:${SITE.contact}`}>{SITE.contact}</a></p>
      <div class="hero-actions">
        <a class="btn" href={url('handbook/')}>Read the handbook</a>
        <span class="btn ghost" aria-disabled="true" title="The paper will be available with the release">Paper (coming soon)</span>
        <a class="btn ghost" href={SITE.notebooksRepo}>Code &amp; notebooks</a>
        <a class="btn ghost" href="#cite">Cite</a>
      </div>
    </div>
  </section>

  <div class="page">
    <figure class="overview">
      <a href={url('static/images/survey_overview.png')} aria-label="Open the survey overview figure at full resolution">
        <img src={url('static/images/survey_overview.png')} width="2832" height="1608" alt="Overview of the survey: Motivation & Concepts, Technical Methods, Research Directions, and Safety & Open Problems" />
      </a>
      <figcaption><strong>Overview of the survey</strong>, organised into four primary pillars: Motivation &amp; Concepts, Technical Methods, Research Directions, and Safety &amp; Open Problems.</figcaption>
    </figure>

    <section aria-labelledby="pillars-h">
      <h2 id="pillars-h">The four pillars</h2>
      <div class="grid pillars">
        {pillars.map((p) => (
          <a class={`pillar pillar-${p.n}`} href={url(p.href)}>
            <span class="pillar-badge">{p.n}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.summary}</p>
            <ul>{p.items.map(([t, d]) => <li><strong>{t}</strong>{d && <span> · {d}</span>}</li>)}</ul>
            <span class="pillar-cta">{p.cta} →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="abstract" aria-labelledby="abs-h">
      <h2 id="abs-h">Abstract</h2>
      <p>We survey interpretability for AI safety, focusing on mechanistic interpretability (MI)—the study of neural networks’ internal representations and computations to develop causal understanding and support targeted interventions. We first situate MI within the broader interpretability landscape, contrasting its mechanism-level evidence with behavioural evaluation while emphasising how behavioural, attributional, and representation-based methods can complement mechanistic analysis. We introduce core foundations for MI from first principles, including features, polysemanticity, superposition, transformer computation, and circuits, and survey methods for feature extraction and analysis, circuit discovery and causal verification, interpreting intermediate representations, training-data attribution, learning dynamics, knowledge localisation, and representation steering. We then characterise six research orientations—Pragmatic, Ambitious, Developmental, Interpretability Across Time, Introspective, and Automated Interpretability—as agendas defined by their goals, assumptions, and trade-offs rather than by exclusive method sets. Finally, we examine how mechanistic understanding can support safety interventions, including knowledge editing, steering, monitoring, and automated interpretability agents, while assessing their limitations, failure modes, open problems, and relationship to behavioural safety measures.</p>
    </section>

    <section aria-labelledby="use-h">
      <h2 id="use-h">Use the handbook</h2>
      <div class="grid grid-3">
        <a class="card tile" href={url('handbook/')}><h3>Online reader</h3><p class="muted small">{chapters.filter((c) => !c.appendix).length} chapters and {manifest.references.length} references, with deep links to every section, figure and table.</p></a>
        <a class="card tile" href={url('methods/')}><h3>Methods explorer</h3><p class="muted small">Filter and compare methods by family. Every entry quotes the survey and links back to it.</p></a>
        <a class="card tile" href={url('evaluation/')}><h3>Evaluation framework</h3><p class="muted small">The five dimensions for judging an interpretability claim.</p></a>
        <a class="card tile" href={url('demos/')}><h3>Interactive demos</h3><p class="muted small">Superposition, sparse autoencoders and activation patching, all computed for real.</p></a>
        <a class="card tile" href={url('notebooks/')}><h3>Notebooks</h3><p class="muted small">{notebooks.notebooks.length} companion notebooks, with compute needs and Colab links.</p></a>
        <a class="card tile" href={url('search/')}><h3>Search</h3><p class="muted small">Full-text search across the whole site.</p></a>
      </div>
    </section>

    <section aria-labelledby="tax-h">
      <h2 id="tax-h">Taxonomy</h2>
      <figure class="taxonomy">
        <a href={url('static/images/survey_taxonomy.png')} aria-label="Open the taxonomy figure at full resolution">
          <img src={url('static/images/survey_taxonomy.png')} width="1730" height="2880" loading="lazy" alt="Taxonomy of interpretability methods covered in the survey, with representative citations for each category" />
        </a>
        <figcaption>Taxonomy of interpretability methods covered in this survey. Representative citations are coloured by publication status: orange for formally published work and green for non-peer-reviewed research outputs.</figcaption>
      </figure>
    </section>

    <section id="cite" aria-labelledby="cite-h">
      <h2 id="cite-h">Citation</h2>
      <p class="muted">The paper link and BibTeX citation will be available with the release.</p>
    </section>
  </div>
</Base>
<style>
  .hero { border-bottom: 1px solid var(--rule); background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%); }
  .hero-inner { max-width: 60rem; margin: 0 auto; padding: 3.5rem 1rem 2.5rem; text-align: center; }
  .hero-title { font-family: var(--serif); font-weight: 600; font-size: clamp(1.8rem, 4.2vw, 2.9rem); line-height: 1.15; margin: .3rem 0 1rem; }
  .hero-title span { display: block; font-size: .55em; font-weight: 400; color: var(--ink-2); margin-top: .5rem; }
  .hero-q { font-family: var(--serif); font-style: italic; font-size: clamp(1.1rem, 2.3vw, 1.4rem); color: var(--navy); margin: 0 auto 1.5rem; max-width: 40rem;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: .8rem 0; }
  .authors { font-size: .92rem; line-height: 1.8; color: var(--ink); max-width: 52rem; margin: 0 auto .5rem; }
  .author { white-space: nowrap; }
  .authors sup { color: var(--ink-3); font-size: .68em; margin-left: .05rem; }
  .affils { font-size: .82rem; color: var(--ink-2); margin: .3rem auto .6rem; max-width: 46rem; }
  .affils summary { cursor: pointer; color: var(--link); }
  .affils ol { columns: 2 16rem; text-align: left; margin: .6rem auto; padding-left: 1.6rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; margin-top: 1.2rem; }
  section { margin: 3rem 0; }
  h2 { font-size: 1.5rem; }
  .overview { margin: 0; text-align: center; }
  .overview img { border: 1px solid var(--rule); border-radius: var(--radius); background: #fff; }
  figcaption { color: var(--ink-2); font-size: .92rem; margin-top: .7rem; }
  .pillars { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 760px) { .pillars { grid-template-columns: 1fr; } }
  .hero-actions .btn { white-space: nowrap; }
  .pillar { display: grid; gap: .3rem; align-content: start; text-decoration: none; color: var(--ink); background: var(--surface); border: 1px solid var(--rule);
    border-top: 4px solid var(--pc); border-radius: var(--radius); padding: 1.1rem 1.2rem 1rem; transition: border-color .15s, transform .15s; }
  .pillar:hover { border-color: var(--pc); }
  .pillar h3 { margin: .2rem 0 0; font-size: 1.15rem; }
  .pillar ul { margin: .4rem 0; padding-left: 1.1rem; font-size: .88rem; color: var(--ink-2); }
  .pillar li { margin: .2rem 0; }
  .pillar li strong { color: var(--ink); font-weight: 600; }
  .pillar-badge { width: 1.8rem; height: 1.8rem; border-radius: 50%; display: grid; place-items: center; background: var(--pc); color: var(--bg); font-weight: 700; font-size: .9rem; }
  .pillar-cta { color: var(--pc); font-weight: 600; font-size: .9rem; margin-top: .3rem; }
  .pillar-1 { --pc: var(--pillar-1); } .pillar-2 { --pc: var(--pillar-2); } .pillar-3 { --pc: var(--pillar-3); } .pillar-4 { --pc: var(--pillar-4); }
  .abstract p { font-family: var(--serif); font-size: 1.08rem; line-height: 1.75; max-width: var(--measure); }
  .tile { text-decoration: none; color: var(--ink); }
  .tile h3 { margin: 0 0 .3rem; font-size: 1.05rem; color: var(--link); }
  .tile:hover { border-color: var(--accent); }
  .taxonomy { margin: 0 auto; max-width: 44rem; text-align: center; }
  .taxonomy img { border: 1px solid var(--rule); border-radius: var(--radius); background: #fff; }
</style>
