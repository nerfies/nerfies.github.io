---
import Base from '../layouts/Base.astro';
import { notebooks, notebookMeta, linksForNotebook, methodById, hypotheses } from '../lib/data';
import { chapters, renderMath, draftHidden } from '../lib/manuscript';
import { url, SITE } from '../lib/site';

// Prerequisites per folder, from the repository README ("Dependencies").
const PREREQ: Record<string, string> = {
  '01_core_hypotheses': 'None. This is the foundation for everything else, so start here.',
  '02_feature_extraction': 'Requires understanding of superposition (01_02).',
  '03_circuits': 'Builds on feature extraction concepts.',
  '04_intermediate_computation': 'Largely independent; can be done in parallel.',
  '05_representation_analysis': 'Requires circuits and intermediate computation.',
  '06_safety_applications': 'Capstone; assumes familiarity with prior sections.',
};
const FOLDER: Record<string, string> = {
  '01_core_hypotheses': 'Core hypotheses', '02_feature_extraction': 'Feature extraction', '03_circuits': 'Circuits',
  '04_intermediate_computation': 'Intermediate computation', '05_representation_analysis': 'Representation analysis', '06_safety_applications': 'Safety applications',
};
const TIER: Record<string, [string, string]> = {
  cpu: ['CPU', 'Runs on a laptop CPU'], gpu: ['GPU', 'Needs a GPU (a free Colab T4 may suffice)'], 'large-gpu': ['Large GPU', 'Needs a large GPU (≥ 40 GB) or multiple GPUs'],
};

// Resolve the notebook's "Survey Reference" against the ingested manuscript by
// TITLE, because the notebooks were numbered against a different manuscript version.
const allSecs = chapters.flatMap((c) => [{ num: c.num, title: c.title, href: url(`handbook/${c.slug}/`) }, ...c.sections.map((s) => ({ num: s.num, title: s.title, href: url(`handbook/${c.slug}/#${s.id}`) }))]);
const words = (s: string) => new Set(s.toLowerCase().replace(/\(.*?\)|\[.*?\]/g, '').match(/[a-z]{4,}/g) ?? []);
function resolve(ref: string | null) {
  if (!ref) return null;
  const m = ref.match(/Section\s+([\d.]+)\s*[-—–:]\s*(.+)/);
  const statedNum = m?.[1] ?? null;
  const title = (m?.[2] ?? ref).replace(/\(\[.*$/, '').trim();
  const w = words(title);
  let best: any = null, score = 0;
  for (const s of allSecs) {
    const sw = words(s.title); const inter = [...w].filter((x) => sw.has(x)).length;
    const sc = inter / Math.max(1, Math.min(w.size, sw.size));
    if (sc > score) { score = sc; best = s; }
  }
  return { statedNum, title, match: score >= 0.5 ? best : null, numMismatch: !!(best && statedNum && score >= 0.5 && best.num !== statedNum) };
}
// notebook overview: markdown-ish text with $…$ maths -> safe HTML with KaTeX
function ovHtml(t: string) {
  let s = t.replace(/\*\*/g, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
  if (s.length > 340) { s = s.slice(0, 340); const open = (s.match(/\$/g) ?? []).length % 2; if (open) s = s.slice(0, s.lastIndexOf('$')); s += '…'; }
  const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return esc(s).replace(/\$([^$]+)\$/g, (_m, tex) => renderMath(`<span class="math inline">${tex}</span>`));
}
const anchor = (p: string) => p.split('/').pop()!.replace('.ipynb', '');
const groups = Object.keys(FOLDER).map((k) => ({ key: k, items: notebooks.filter((n) => n.section_dir === k) }));
const hypById = new Map(hypotheses.map((h: any) => [h.id, h]));
const stats = { total: notebooks.length, cpu: notebooks.filter((n) => n.compute.tier === 'cpu').length };
---
<Base title="Notebooks" description="Catalogue of the companion notebooks: purpose, survey section, prerequisites, compute, dependencies and Colab links.">
  <div class="page">
    <p class="eyebrow">Hands-on</p>
    <h1>Companion notebooks</h1>
    <p class="lede">{stats.total} notebooks from <a href={SITE.notebooksRepo}>TSGLAB/Interpretability_Survey_Safety</a>, {stats.cpu} run on a CPU.</p>

    <div class="filters" role="group" aria-label="Filter by compute">
      <button class="chip on" data-tier="all" aria-pressed="true">All</button>
      {Object.entries(TIER).map(([k, [l]]) => <button class="chip" data-tier={k} aria-pressed="false">{l} ({notebooks.filter((n) => n.compute.tier === k).length})</button>)}
    </div>

    {groups.map((g) => (
      <section class="nb-group">
        <h2>{FOLDER[g.key]}</h2>
        <p class="small muted">Prerequisites: {PREREQ[g.key]}</p>
        <div class="grid">
          {g.items.map((n) => {
            const r = resolve(n.survey_reference);
            const L = linksForNotebook(n.path);
            const tier = TIER[n.compute.tier];
            return (
              <article class="card nb" id={anchor(n.path)} data-tier={n.compute.tier}>
                <div class="nb-main">
                  <div class="nb-head">
                    <h3><a href={`#${anchor(n.path)}`}>{n.title}</a></h3>
                    <span class={`chip tier-${n.compute.tier}`} title={`${tier[1]}. ${n.compute.basis}.`}>{tier[0]}{n.compute.largest_model_b ? ` · ${n.compute.largest_model_b >= 1 ? n.compute.largest_model_b + 'B' : Math.round(n.compute.largest_model_b * 1000) + 'M'} params` : ''}</span>
                  </div>
                  <p class="small path"><code>{n.path}</code></p>
                  {n.overview && <p class="ov" set:html={ovHtml(n.overview)} />}
                  <dl class="meta">
                    <dt>Survey section</dt>
                    <dd>{r ? (<>
                        {draftHidden ? <span>{n.survey_reference.replace(/\(\[.*$/, '').replace(/\]\(.*$/, '').trim()}</span> : <>
                        {r.match ? <a href={r.match.href}>§{r.match.num} {r.match.title}</a> : <span>{n.survey_reference.replace(/\(\[.*$/, '').trim()}</span>}</>}
                      </>) : <span class="muted">—</span>}</dd>
                    <dt>Learning outcomes</dt>
                    <dd>{n.learning_objectives.length ? <ul>{n.learning_objectives.slice(0, 5).map((o: string) => <li>{o.replace(/\*\*/g, '')}</li>)}</ul>
                      : n.key_methods.length ? <><span class="small muted">Covers:</span><ul>{n.key_methods.map((o: string) => <li>{o.replace(/\*\*/g, '')}</li>)}</ul></>
                      : <span class="muted">—</span>}</dd>
                    <dt>Models</dt><dd>{n.models.length ? n.models.join(', ') : 'None (toy or synthetic data)'}{n.gated_models.length > 0 && <span class="chip note" title="Requires accepting the model licence on Hugging Face">gated: {n.gated_models.join(', ')}</span>}</dd>
                    <dt>Dependencies</dt><dd class="small"><code>{n.imports.join(', ')}</code>
                      
                      {n.local_modules.length > 0 && <div class="small note-text">Needs modules from the repository: {n.local_modules.join(', ')}</div>}</dd>
                    {n.external.length > 0 && <><dt>Needs</dt><dd>{n.external.join(' · ')}</dd></>}
                    {!draftHidden && (L.methods?.length || L.hypotheses?.length) && <><dt>In the explorer</dt><dd>
                      {(L.methods ?? []).map((id: string) => methodById.get(id)).filter(Boolean).map((m: any, i: number) => <>{i > 0 && ', '}<a href={url(`methods/${m.id}/`)}>{m.name}</a></>)}
                      {(L.hypotheses ?? []).map((id: string) => hypById.get(id)).filter(Boolean).map((h: any) => <span> {h.name}</span>)}
                    </dd></>}
                  </dl>
                  <div class="actions">
                    <a class="btn" href={n.links.colab} target="_blank" rel="noopener">Open in Colab</a>
                    <a class="btn ghost" href={n.links.source} target="_blank" rel="noopener">View source</a>
                  </div>
                  {n.colab_blockers.length > 0 && <p class="small note-text">Colab note: {n.colab_blockers.join('; ')}.</p>}
                </div>
                {n.preview_image && (
                  <figure class="preview">
                    <img src={url(`notebook-previews/${n.preview_image}`)} alt={`First saved output plot from the notebook “${n.title}”`} loading="lazy" />
                    
                  </figure>
                )}
              </article>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  .filters { display: flex; gap: .35rem; flex-wrap: wrap; margin: 1rem 0; }
  .nb-group { margin: 2.5rem 0; }
  .nb-group h2 { margin-bottom: .2rem; }
  .nb { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 15rem); gap: 1.2rem; }
  .nb:not(:has(.preview)) { grid-template-columns: minmax(0, 1fr); }
  @media (max-width: 760px) { .nb { grid-template-columns: minmax(0, 1fr); } }
  .nb-head { display: flex; gap: .6rem; flex-wrap: wrap; align-items: baseline; }
  .nb-head h3 { margin: 0; font-size: 1.08rem; }
  .nb-head h3 a { color: var(--ink); text-decoration: none; }
  .path { margin: .2rem 0 .5rem; color: var(--ink-3); word-break: break-all; }
  .ov { font-size: .93rem; color: var(--ink-2); margin: .3rem 0 .6rem; }
  .meta { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: .35rem .8rem; font-size: .88rem; margin: .5rem 0; }
  .meta dt { color: var(--ink-3); } .meta dd { margin: 0; } .meta ul { margin: .1rem 0; padding-left: 1.1rem; }
  @media (max-width: 520px) { .meta { grid-template-columns: minmax(0, 1fr); } .meta dt { margin-top: .4rem; font-weight: 600; } }
  .actions { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .8rem; }
  .preview { margin: 0; } .preview img { border: 1px solid var(--rule); border-radius: 6px; background: #fff; }
  .chip.note { margin-left: .35rem; color: var(--ink-2); }
  .note-text { color: var(--ink-2); margin: .3rem 0 0; }
  .tier-cpu { color: var(--measured); border-color: var(--measured); } .tier-gpu { color: var(--gold); border-color: var(--gold); } .tier-large-gpu { color: var(--tier-flagged); border-color: var(--tier-flagged); }
  .nb[hidden] { display: none; }
</style>
<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-tier]').forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.tier;
    document.querySelectorAll('button[data-tier]').forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    document.querySelectorAll<HTMLElement>('article.nb').forEach((a) => { a.hidden = t !== 'all' && a.dataset.tier !== t; });
  }));
</script>
