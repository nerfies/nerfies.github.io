---
import Base from '../layouts/Base.astro';
import Excerpt from '../components/Excerpt.astro';
import { excerptHtml, sectionLink } from '../lib/manuscript';
import { resolveMethod } from '../lib/data';
import { url } from '../lib/site';
import data from '../data/orientations-arxiv.json';
// Quoted from §12 of the paper as published on arXiv (generated by
// scripts/data/build_orientations_arxiv.py). The handbook reader still shows the
// ingested working draft, which had five orientations; this page follows the paper.
const src = data.source;
const ref = (num: string, title: string) => ({ num, title, href: src.abs });
const orientations: any[] = data.orientations;
const table = data.comparison;
const figHref = sectionLink('fig:sixresearchorientation');
import { draftHidden as __hide } from '../lib/manuscript';
if (__hide) return Astro.rewrite(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}held/`);
---
<Base title="Research orientations" description="The survey's six research orientations: agendas defined by goals, assumptions and trade-offs rather than by exclusive sets of methods.">
  <div class="page">
    <p class="eyebrow">Research directions</p>
    <h1>Research orientations</h1>
    <p class="small muted">From §{src.chapter} of the paper.</p>
    {data.intro.map((t: string) => <Excerpt text={t} section={ref(src.chapter, src.chapter_title)} />)}

    {/* Figure 17 of the paper, rendered from figs/research_directions_compressed.pdf at 2400 px wide. */}
    <figure class="fig-orient" id="figure-17">
      <a href={url('static/images/research_orientations.png')} aria-label="Open Figure 17 at full resolution">
        <img src={url('static/images/research_orientations.png')} width="2400" height="912" loading="lazy"
          alt="Figure 17: the six research orientations, each with a small illustration: Pragmatic, Ambitious, Automated, Developmental, Introspective, and Interpretability Across Time." />
      </a>
      <figcaption><strong>Figure 17:</strong> Six research orientations of AI interpretability.
        {figHref && <a href={figHref}>In the handbook</a>}</figcaption>
    </figure>

    <div class="orient-grid" role="list">
      {orientations.map((o, i) => (
        <article class="card orient" role="listitem" id={o.id}>
          {o.id === 'introspective-interpretability' && <span id="agentic" aria-hidden="true"></span>}
          <span class="o-n">{i + 1}</span>
          <h2>{o.name}</h2>
          <p class="muted small" style="margin:.1rem 0 .6rem">{o.subtitle}</p>
          <Excerpt text={o.definition} section={ref(o.section, o.section_title)} />
          {o.list_terms.length > 0 && <p class="small"><span class="muted">{o.list_label}:</span>{' '}
            {o.list_terms.map((n: string, j: number) => { const m = o.list_label === 'Methods' ? resolveMethod(n) : null; return <>{j > 0 && ', '}{m ? <a href={url(`methods/${m.id}/`)}>{n}</a> : n}</>; })}</p>}
          <details>
            <summary class="small">Read §{o.section} in full</summary>
            {o.body.map((b: any) => b.p ? <Excerpt text={b.p} />
              : b.h ? <h3>§{b.section} {b.h}</h3>
              : <ul class="o-list">{b.ul.map((it: any) => <li set:html={excerptHtml(it.text)} />)}</ul>)}
          </details>
        </article>
      ))}
    </div>

    <section style="margin-top:3rem">
      <h2>Side-by-side comparison</h2>
      {table.intro.map((t: string) => <Excerpt text={t} />)}
      <p class="small muted">{table.caption}</p>
      <div class="role-filter" role="group" aria-label="Show columns">
        {table.columns.slice(1).map((c: string) => <label class="chip"><input type="checkbox" checked data-col={c} /> {c}</label>)}
      </div>
      <div class="scroll-x"><table class="data" id="cmp">
        <thead><tr>{table.columns.map((c: string) => <th data-col={c}>{c}</th>)}</tr></thead>
        <tbody>{table.rows.map((r: any) => <tr>{table.columns.map((c: string, j: number) => j === 0 ? <th scope="row" set:html={excerptHtml(String(r[c] ?? ''))} /> : <td data-col={c} set:html={excerptHtml(String(r[c] ?? ''))} />)}</tr>)}</tbody>
      </table></div>
      <p class="small muted">In the survey: <a href={src.abs}>§{table.section}</a></p>
    </section>

    <section style="margin-top:3rem">
      <h2>Choosing an orientation</h2>
      {data.decision.paragraphs.map((t: string) => <Excerpt text={t} section={ref(data.decision.section, 'Choosing an Orientation: A Decision Framework')} />)}
    </section>
    <section style="margin-top:3rem">
      <h2>Critical tensions</h2>
      {data.tensions.paragraphs.map((t: string) => <Excerpt text={t} section={ref(data.tensions.section, 'Critical Concerns, Tensions, and Open Questions')} />)}
    </section>
  </div>
</Base>
<style>
  .fig-orient { margin: 2rem 0 2.5rem; }
  /* white backing so the figure (dark line art) stays legible in dark mode */
  .fig-orient img { display: block; width: 100%; height: auto; background: #fff; }
  .fig-orient figcaption { font-size: .84rem; color: var(--ink-2); margin-top: .7rem; }
  .fig-orient figcaption a { margin-left: .4rem; }
  .orient-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .orient { position: relative; border-top: 3px solid var(--pillar-3); }
  .orient h2 { font-size: 1.1rem; margin: 0; padding-right: 2rem; }
  .orient h3 { font-size: .85rem; margin: .9rem 0 .2rem; text-transform: uppercase; letter-spacing: .05em; color: var(--ink-3); }
  .o-list { font-size: .92rem; padding-left: 1.2rem; margin: .4rem 0 .8rem; }
  .o-list li { margin-bottom: .35rem; }
  .o-n { position: absolute; top: .9rem; right: 1rem; font-family: var(--mono); color: var(--gold); font-weight: 700; }
  .role-filter { display: flex; flex-wrap: wrap; gap: .35rem; margin: .5rem 0 .8rem; }
  .role-filter label { cursor: pointer; display: inline-flex; gap: .3rem; align-items: center; }
  details summary { cursor: pointer; color: var(--link); margin-top: .5rem; }
</style>
<script>
  document.querySelectorAll<HTMLInputElement>('.role-filter input').forEach((cb) => cb.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>(`#cmp [data-col="${cb.dataset.col}"]`).forEach((el) => { el.hidden = !cb.checked; });
  }));
</script>
